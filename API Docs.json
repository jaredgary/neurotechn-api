							"maximum": 28,
							"minimum": 7,
							"description": "Horizonte: 7, 14 o 28 días",
							"default": 28,
							"title": "H"
						},
						"description": "Horizonte: 7, 14 o 28 días"
					},
					{
						"name": "n",
						"in": "query",
						"required": false,
						"schema": {
							"type": "integer",
