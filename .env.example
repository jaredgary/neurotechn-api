# ============================================
# CONFIGURACIÓN MVP FARMACIAS SIMAN
# ============================================
# Copiar este archivo a .env y completar con valores reales

# === SUPABASE CONFIGURATION ===
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_KEY=tu-service-key-aqui  # Opcional, para operaciones de escritura

# === API CONFIGURATION ===
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false  # true para desarrollo, false para producción

# === SECURITY ===
SECRET_KEY=tu-secret-key-super-segura-aqui-minimo-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === MODEL CONFIGURATION ===
MODEL_VERSION=1.0.0
MODEL_NAME=xgboost
TRAINING_WINDOW_DAYS=90
MIN_TRAINING_SAMPLES=30

# === XGBOOST HYPERPARAMETERS ===
XGBOOST_N_ESTIMATORS=100
XGBOOST_MAX_DEPTH=6
XGBOOST_LEARNING_RATE=0.1
XGBOOST_SUBSAMPLE=0.8
XGBOOST_COLSAMPLE_BYTREE=0.8
XGBOOST_RANDOM_STATE=42

# === PERFORMANCE TARGETS ===
TARGET_MAPE=30.0
TARGET_DASHBOARD_UPDATE_MINUTES=15
TARGET_AVAILABILITY=99.5

# === ALERT CONFIGURATION ===
ALERT_CHECK_INTERVAL_HOURS=4
ALERT_STOCK_CRITICAL_THRESHOLD=0.2
ALERT_EXPIRY_DAYS_CRITICAL=7
ALERT_EXPIRY_DAYS_WARNING=30

# === DATA QUALITY ===
MIN_DATA_COMPLETENESS=0.8
MAX_OUTLIER_PERCENTAGE=0.05

# === CACHING ===
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# === MONITORING (Opcional) ===
SENTRY_DSN=  # Dejar vacío si no se usa Sentry
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true

# === DATABASE POOL ===
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# === FEATURE FLAGS ===
ENABLE_ADVANCED_FEATURES=false
ENABLE_DEEP_LEARNING=false
ENABLE_AUTO_RETRAINING=true

# === BUSINESS RULES ===
ESSENTIAL_MEDICINE_MULTIPLIER=1.5
MAX_LEAD_TIME_DAYS=30
DEFAULT_SAFETY_STOCK_DAYS=7