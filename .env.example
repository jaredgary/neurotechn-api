# =====================================================================
# CONFIGURACIÓN BACKEND FASTAPI - FARMACIAS SIMAN
# Sistema de Alertas Predictivas
# Versión: 1.1.0
# =====================================================================

# =========================
# SUPABASE (REQUERIDO)
# =========================
# URL del proyecto Supabase (ej: https://xxxxx.supabase.co)
SUPABASE_URL=your_supabase_project_url

# Anon/Public Key (para operaciones con RLS)
SUPABASE_KEY=your_supabase_anon_key

# Service Role Key (para operaciones admin/ETL - ⚠️ MANTENER SECRETO)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key


# =========================
# APLICACIÓN (OPCIONAL)
# =========================
# Nombre de la aplicación
# APP_NAME=Farmacias Siman - Sistema Predictivo

# Versión
# APP_VERSION=1.1.0

# Debug mode (True para desarrollo, False para producción)
# DEBUG=False

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO


# =========================
# SERVIDOR (OPCIONAL)
# =========================
# Host del servidor
# HOST=0.0.0.0

# Puerto del servidor
# PORT=8000


# =========================
# CORS (OPCIONAL)
# =========================
# Orígenes permitidos para peticiones cross-origin (separados por comas)
# IMPORTANTE: Incluir TODOS los dominios desde donde se accederá a la API
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://farmacias-siman-frontend.fly.dev,https://farmacias-siman-api.fly.dev
#
# Valores por defecto en config.py:
# - http://localhost:3000 (desarrollo React)
# - http://localhost:5173 (desarrollo Vite)
# - http://localhost:8000 (desarrollo FastAPI)
# - https://farmacias-siman-frontend.fly.dev (producción frontend)
# - https://farmacias-siman-api.fly.dev (producción backend)
# - https://farmacias-siman.fly.dev (legacy/alternativo)


# =========================
# NOTAS IMPORTANTES
# =========================
#
# 1. Las variables marcadas como REQUERIDO deben ser configuradas
# 2. Las variables OPCIONAL tienen valores por defecto en config.py
# 3. NUNCA subir el archivo .env real a git (está en .gitignore)
# 4. Para obtener las credenciales de Supabase:
#    - Ir a https://supabase.com/dashboard/project/YOUR_PROJECT
#    - Settings > API > Project URL y API Keys
# 5. La Service Role Key bypasa RLS - usar solo en backend
#
# =========================
# VERIFICACIÓN DE MÉTRICAS
