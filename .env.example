# Environment Configuration for Farmacias Siman MVP

# Environment
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# Database Configuration (for direct connection if needed)
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration (for caching and Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=False

# Security
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Model Configuration
MODEL_PATH=/app/models
MODEL_VERSION=1.0.0
FORECAST_HORIZONS=7,14,28
TRAINING_WINDOW_DAYS=90
MAPE_THRESHOLD=30

# Alert Configuration
ALERT_CHECK_INTERVAL_HOURS=4
STOCK_ALERT_THRESHOLD_DAYS=7
EXPIRATION_ALERT_THRESHOLD_DAYS=30

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
PROMETHEUS_PORT=9090

# External Services (optional)
WEATHER_API_KEY=your-weather-api-key
EPIDEMIOLOGY_API_URL=https://api.epidemiology.example.com

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_RECIPIENTS=admin@farmaciassiman.com,manager@farmaciassiman.com

# Timezone
TIMEZONE=America/Tegucigalpa