# =====================================================================
# BACKEND FASTAPI - Sistema Predictivo de Inventario Farmacéutico
# Versión: 2.0.0 - SaaS Genérico con Cálculo Dinámico
# =====================================================================

# ==========================================================
# INFORMACIÓN DE LA APLICACIÓN
# ==========================================================
APP_NAME="Sistema Predictivo de Inventario Farmacéutico"
APP_VERSION="2.0.0"
API_V1_PREFIX="/api/v1"

# ==========================================================
# SUPABASE (Base de Datos) - REQUERIDO
# ==========================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ==========================================================
# SERVIDOR
# ==========================================================
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# ==========================================================
# UMBRALES DE NEGOCIO (Configurables por empresa)
# Estos SÍ pueden estar "hardcodeados" porque son decisiones de negocio
# ==========================================================

# Configuración de Alertas
LEAD_TIME_BUFFER_DAYS=2
SAFETY_STOCK_THRESHOLD=1.0
MIN_CONFIDENCE_THRESHOLD=0.70

# Clasificación de riesgo (umbrales en días)
RISK_CRITICAL_DAYS=7
RISK_HIGH_DAYS=10

# Horizontes de predicción soportados (lista separada por comas)
PREDICTION_HORIZONS=7,14,28
ALERT_HORIZONS=7,14

# Walk-forward validation para ML
INITIAL_TRAIN_DAYS=60
STEP_SIZE_DAYS=7

# SLOs (Service Level Objectives)
SLO_DISPONIBILIDAD_PCT=99.0
SLO_LATENCIA_TABLERO_MS=5000
SLO_LATENCIA_ALERTAS_MS=3000
ERROR_BUDGET_HORAS=7.2

# Configuración de modelos ML (XGBoost)
XGBOOST_N_ESTIMATORS=50
XGBOOST_MAX_DEPTH=4
XGBOOST_LEARNING_RATE=0.1
XGBOOST_RANDOM_STATE=42

# ==========================================================
# NOTA IMPORTANTE - PRINCIPIO FUNDAMENTAL
# ==========================================================
# "CÁLCULO DINÁMICO - CERO HARDCODEO DE MÉTRICAS"
#
# Las siguientes métricas NO están aquí porque se calculan dinámicamente:
# - TOTAL_SKUS: Se cuenta de catalogo_medicamentos
# - XGBOOST_MAE_PROMEDIO: Se calcula de backtest_results
# - ALERTAS_ACCIONABLES_PCT: Se calcula de alert_evaluation_results
# - VIABILIDAD_GLOBAL: Se calcula de múltiples fuentes
#
# Todas las métricas se obtienen mediante endpoints dedicados:
# - GET /api/v1/sistema/metricas-ml
# - GET /api/v1/sistema/metricas-alertas
# - GET /api/v1/dashboard/stats
# - GET /api/v1/sistema/configuracion
# ==========================================================

# ==========================================================
# INSTRUCCIONES
# ==========================================================
# 1. Copiar este archivo a .env
# 2. Completar las credenciales de Supabase (REQUERIDO)
# 3. Ajustar umbrales de negocio según necesidades
# 4. NUNCA subir el archivo .env real a git (está en .gitignore)
#
# Para obtener credenciales de Supabase:
# - Ir a https://supabase.com/dashboard/project/YOUR_PROJECT
# - Settings > API > Project URL y API Keys
# - La Service Role Key bypasa RLS - usar solo en backend
# ==========================================================
